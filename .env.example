# Backend Environment Variables (EasyPanel → backend → Environment)
DATABASE_URL=mysql+pymysql://samy:YOUR_PASSWORD@confortdz_database:3306/confortdz
ALLOWED_ORIGINS=https://confortdz.shop,http://localhost:3000
SECRET_KEY=generate_a_strong_secret_key_here

# Admin dashboard — https://api.confortdz.shop/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_TOKEN_HOURS=12

# Analytics IP validation (Algeria only, excludes VPN/proxy/hosting)
IP_LOOKUP_TTL_SECONDS=86400
IP_LOOKUP_TIMEOUT=2.5
ANALYTICS_COUNT_PRIVATE_IPS=false

# Accounting — product cost as % of delivered revenue (default 55%)
DEFAULT_COGS_RATIO=0.55

# Google Sheets webhook (server-side — more reliable than browser)
# Google Sheets webhook (optional — default: Frontend sends directly)
# Set GOOGLE_SHEET_FROM_BACKEND=true only if you disable Frontend webhook
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_SHEET_FROM_BACKEND=false

# Conversion API (optional — for server-side tracking)
META_PIXEL_ID=your_meta_pixel_id
META_ACCESS_TOKEN=your_meta_conversions_api_token
TIKTOK_PIXEL_CODE=your_tiktok_pixel_id
TIKTOK_ACCESS_TOKEN=your_tiktok_events_api_token
SNAP_PIXEL_ID=your_snap_pixel_id
SNAP_ACCESS_TOKEN=your_snap_conversions_api_token
CAPI_TEST_MODE=false

# Anti-fraud (competitor / fake order protection)
# Add your home/office IP to order from desktop during testing
ALLOWED_DESKTOP_IPS=YOUR_PUBLIC_IP_HERE
HIGH_PRICE_THRESHOLD=5000
MAX_QTY_HIGH_PRICE=2
MAX_QTY_LOW_PRICE=4
ORDERS_PER_IP_PER_DAY=1
ORDERS_PER_PHONE_PER_DAY=1

# DHD (EcoTrack) — livraison automatique
# Token from: https://dhd.ecotrack.dz → your account → API
DHD_API_TOKEN=your_dhd_api_token_here
DHD_API_URL=https://dhd.ecotrack.dz
# Set true only after WhatsApp confirmation (recommended)
DHD_SHIP_ON_ORDER=false

# Optional — if Apps Script calls backend to ship (instead of direct DHD token in script)
SHEETS_SHIP_SECRET=generate_a_random_secret_here
